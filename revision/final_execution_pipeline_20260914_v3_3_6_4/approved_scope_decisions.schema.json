{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User-Approved NFT Revision Scope Decisions (v3.3.6.4)",
  "type": "object",
  "required": [
    "governance_status",
    "execution_profile",
    "candidate_manifest_sha256",
    "target_execution_engine",
    "decisions"
  ],
  "properties": {
    "governance_status": {
      "const": "USER_APPROVED"
    },
    "execution_profile": {
      "enum": [
        "recommended_16",
        "confirmatory_12"
      ]
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_execution_engine": {
      "const": "revision/final_execution_pipeline_20260914_v3_3_6_4/"
    },
    "decisions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "status",
          "selected_option"
        ],
        "properties": {
          "decision_id": {
            "enum": [
              "DECISION-01",
              "DECISION-02",
              "DECISION-03",
              "DECISION-04"
            ]
          },
          "status": {
            "const": "USER_APPROVED"
          },
          "selected_option": {
            "const": "A"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
